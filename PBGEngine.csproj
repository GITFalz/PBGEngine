<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PBGEngine</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="Engine.Core\Engine.Core.csproj" />
    <ProjectReference Include="Assets\Assets.csproj" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <Target Name="CopyAssetsAssembly" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets\bin\$(Configuration)\$(TargetFramework)\Assets.dll"
          DestinationFolder="$(TargetDir)" />
  </Target>

</Project>